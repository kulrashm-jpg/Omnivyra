# WRITER-CERT-002 — Certification environment (ISOLATED; never production).
# Copy to .env.cert and load it INSTEAD of .env.local for any cert run.
# The cert-isolation guard (scripts/cert/assert-cert-isolation.mjs) hard-refuses
# to run if any value points at the production project ref.

# ── Isolated local Postgres (built by scripts/cert/build-cert-db.sh) ─────────
SUPABASE_POOLER_DB_URL=postgresql://postgres:postgres@localhost:54322/certfull

# ── Local Supabase API stack (PostgREST/Auth) fronting the cert DB ───────────
# Stand up via `supabase start` pointed at the cert DB, or a local PostgREST.
# MUST be a localhost URL — NEVER the production *.supabase.co project.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
SUPABASE_URL=http://localhost:54321
# Local dev anon/service keys (the well-known local supabase demo keys, or your
# own local stack's keys). NEVER the production service_role key.
NEXT_PUBLIC_SUPABASE_ANON_KEY=REPLACE_WITH_LOCAL_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_LOCAL_SERVICE_KEY

# ── Local Redis (docker-compose.yml provides one) ────────────────────────────
REDIS_URL=redis://localhost:6379

# ── AI provider — use a CERT/sandbox key with a hard spend cap, or a mock ────
# Set CERT_AI_MOCK=1 to route generation through a deterministic stub instead of
# a real provider (recommended for reproducible, cost-free runtime cert).
OPENAI_API_KEY=REPLACE_WITH_SANDBOX_KEY_OR_LEAVE_FOR_MOCK
CERT_AI_MOCK=1

# ── Writer feature flags for cert (validate both legacy and canonical) ───────
WRITER_RUNTIME_DELEGATION_ENABLED=off   # flip to `on` for Phase-9 parity runs
ORIGINALITY_GATE_ENABLED=on
QUALITY_ENGINE_ENABLED=on

# Marks this as the cert env for tooling.
CERT_ENV=1
