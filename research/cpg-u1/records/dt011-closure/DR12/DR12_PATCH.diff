-const assigned = (v) => typeof v === 'string' && v.trim() !== '' && v !== UNASSIGNED;
+// The UNASSIGNED sentinel is a marker, not data: it is matched after trimming and case-folding, so that
+// "UNASSIGNED " or "unassigned" cannot be passed off as a supplied value. toUpperCase (not toLowerCase)
+// is the fail-closed direction. `padded` is reported separately: a supplied value is never silently
+// rewritten here, because checkAuthority() compares accountable_identity.value for exact equality.
+const isUnassignedSentinel = (v) => v.trim().toUpperCase() === UNASSIGNED;
+const padded = (v) => v !== v.trim();
+const assigned = (v) => typeof v === 'string' && v.trim() !== '' && !isUnassignedSentinel(v);
 
