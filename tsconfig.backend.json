{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": true
  },
  "include": [
    "backend/**/*.ts",
    "backend/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx",
    "pages/api/**/*.ts",
    "pages/api/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "docs",
    "tmp",
    "tmp_*",
    "artifacts",
    "backend/tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
