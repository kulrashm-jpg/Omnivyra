# BETA-022 — Beta testing environment (NON-PRODUCTION).
#
# Copy to a real env file OUTSIDE the repo (or a gitignored .env.beta) and source it before
# running the beta seed/verify scripts. These MUST point at a non-production Supabase — the
# local `supabase start` stack, or a throwaway cloud project. The scripts hard-refuse to run
# against the production project ref.
#
#   bash / git-bash:   set -a; . ./beta.keys.env; set +a
#   PowerShell:        Get-Content beta.keys.env | %{ if($_ -match '^\s*([^#=]+)=(.*)$'){ [Environment]::SetEnvironmentVariable($matches[1].Trim(),$matches[2]) } }

# ── Local Supabase stack (default `supabase start` ports) ─────────────────────
BETA_SUPABASE_URL=http://localhost:54321
# Obtain the anon (publishable) + service (secret) keys for YOUR local stack via `supabase status`.
# New-format keys look like sb_publishable_xxx / sb_secret_xxx; legacy are JWT (eyJ...). Do not commit real keys.
BETA_SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
BETA_SUPABASE_SERVICE_KEY=sb_secret_REPLACE_ME
# Direct Postgres (schema inspection only; the scripts use the REST/Admin API, not this):
BETA_DB_URL=postgresql://postgres:postgres@localhost:54322/postgres

# ── RULE 3 — zero-cost deterministic image generation ─────────────────────────
# Runs OpenAI-free mock rendering (BETA-020). Set in whatever process runs the app/worker.
BETA_AI_MODE=1
