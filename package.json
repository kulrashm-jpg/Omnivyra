{
  "name": "omnivyra-admin-ui",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/start-all.js --app-only",
    "dev:full": "node scripts/start-all.js",
    "dev:app": "node scripts/start-all.js --app-only",
    "prebuild": "node scripts/enforce-decision-intelligence.js && node -e \"try{require('fs').rmSync('.next/lock',{recursive:true,force:true})}catch(e){}\"",
    "clean": "node scripts/clean.js",
    "build": "npm run clean && next build --webpack",
    "build:ci": "npm run build",
    "build:webpack": "npm run clean && next build --webpack",
    "prestart": "node scripts/clean.js --bg",
    "start": "next start",
    "worker:all": "node dist/backend/workers/main.js",
    "worker:cron": "node dist/backend/scheduler/cron.js",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start:worker": "node -r ts-node/register backend/queue/worker.ts",
    "worker": "ts-node backend/queue/worker.ts",
    "worker:leads": "node -r ts-node/register backend/workers/leadWorker.ts",
    "worker:bolt": "npx ts-node --transpile-only backend/queue/startWorkers.ts",
    "start:workers": "npx ts-node --transpile-only backend/queue/startWorkers.ts",
    "intelligence:enqueue": "npx ts-node backend/scripts/triggerIntelligenceEnqueue.ts",
    "start:cron": "node -r ts-node/register backend/scheduler/cron.ts",
    "test": "jest backend/tests --runInBand --forceExit",
    "test:lead-signals": "tsx scripts/validate_signal_flow.ts",
    "setup:env": "node scripts/setup-helpers/setup-env.js",
    "setup:key": "node scripts/setup-helpers/generate-encryption-key.js",
    "setup:verify": "node scripts/setup-helpers/verify-setup.js",
    "setup:redis": "node scripts/setup-helpers/check-redis.js",
    "migrate:p2": "node scripts/apply-p2-migrations.js",
    "test:p0": "node scripts/test-p0-module.js",
    "test:p2": "node scripts/test-p2-module.js",
    "test:all": "node scripts/test-p0-module.js && node scripts/test-p2-module.js",
    "audit:blog-matrix": "node -e \"process.env.TS_NODE_COMPILER_OPTIONS='{\\\"module\\\":\\\"commonjs\\\"}'; require('ts-node/register/transpile-only'); require('tsconfig-paths/register'); require('./scripts/audit-blog-combinations.js');\"",
    "audit:blog-matrix:guard": "node -e \"process.env.TS_NODE_COMPILER_OPTIONS='{\\\"module\\\":\\\"commonjs\\\"}'; require('ts-node/register/transpile-only'); require('tsconfig-paths/register'); process.argv.push('--require-all-pass','--min-average','80'); require('./scripts/audit-blog-combinations.js');\"",
    "audit:newsletter-matrix": "node -e \"process.env.TS_NODE_COMPILER_OPTIONS='{\\\"module\\\":\\\"commonjs\\\"}'; require('ts-node/register/transpile-only'); require('tsconfig-paths/register'); require('./scripts/audit-newsletter-combinations.js');\"",
    "migrate:quick-fix": "echo 'Please run scripts/quick-fix-migration.sql in Supabase SQL Editor, then run: npm run test:all'",
    "backfill:signal-embeddings": "npx ts-node scripts/backfill-signal-embeddings.ts",
    "backfill:lead-signals": "tsx scripts/backfill_lead_signals.ts",
    "backfill:contacts": "tsx scripts/backfill_contacts.ts",
    "verify:lead-signal-cutover": "tsx scripts/verify_lead_signal_cutover.ts",
    "backfill": "tsx scripts/backfill_lead_signals.ts",
    "verify": "tsx scripts/verify_lead_signal_cutover.ts",
    "check": "tsx scripts/canonical_readiness_check.ts",
    "inject:test-signal": "tsx scripts/inject_test_signal.ts",
    "env:validate": "tsx scripts/validate_startup_env.ts",
    "lint:lead-signal-boundary": "node scripts/check_lead_signal_write_boundaries.js",
    "audit:legacy-ledger-reads": "tsx scripts/audit-legacy-ledger-reads.ts",
    "check:frozen-schemas": "tsx scripts/check-frozen-schemas.ts",
    "guard:cost-tracking": "npm run audit:legacy-ledger-reads && npm run check:frozen-schemas",
    "lint": "eslint . --max-warnings 200",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.backend.json --noEmit && tsc -p tsconfig.scripts.json --noEmit",
    "check:file-lengths": "node scripts/check-file-lengths.js",
    "update:browserslist": "npm install caniuse-lite@latest --legacy-peer-deps",
    "fresh": "npm run clean && npm run update:browserslist && npm run dev",
    "rpa:install": "npx playwright install chromium",
    "rpa:check": "node -e \"(async()=>{try{const p=await import('playwright');const b=await p.chromium.launch({headless:true});await b.close();console.log('RPA_ENV_READY');}catch(e){console.error('RPA_ENV_NOT_READY',e?.message);process.exit(1);}})()\""
  },
  "dependencies": {
    "@alloc/quick-lru": "^5.2.0",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.103.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tiptap/extension-color": "^2.27.2",
    "@tiptap/extension-font-family": "^2.27.2",
    "@tiptap/extension-image": "^2.27.2",
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/extension-placeholder": "^2.27.2",
    "@tiptap/extension-text-align": "^2.27.2",
    "@tiptap/extension-text-style": "^2.27.2",
    "@tiptap/extension-underline": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@types/formidable": "^3.4.6",
    "@types/node": "^24.5.2",
    "axios": "^1.13.5",
    "bullmq": "^5.76.1",
    "caniuse-lite": "^1.0.30001777",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "formidable": "^3.5.4",
    "ioredis": "^5.9.3",
    "lucide-react": "^0.544.0",
    "next": "^16.1.6",
    "openai": "^5.23.0",
    "pdfkit": "^0.17.2",
    "pg": "^8.16.3",
    "playwright": "^1.49.0",
    "react": "latest",
    "react-dom": "latest",
    "react-icons": "^5.6.0",
    "react-markdown": "^9.0.1",
    "recharts": "^3.8.1",
    "rehype-raw": "^7.0.0",
    "tailwindcss": "^3.4.17",
    "undici": "^6.25.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@babel/core": "^7.28.5",
    "@jest/globals": "^29.7.0",
    "@types/express": "^5.0.6",
    "@types/react": "19.1.13",
    "autoprefixer": "^10.4.21",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^16.1.6",
    "jest": "^29.7.0",
    "postcss": "^8.5.6",
    "ts-jest": "^29.1.2",
    "ts-node": "^10.9.2",
    "tsx": "^4.21.0",
    "typescript": "5.9.2"
  }
}
