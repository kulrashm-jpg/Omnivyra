{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false
  },
  "include": [
    "next-env.d.ts",
    "pages/command-center/creator-content.tsx",
    "pages/command-center/creator-content/[type].tsx",
    "pages/blogs/new.tsx",
    "lib/content/creatorContentBridge.ts",
    "lib/content/creatorFlowContext.ts",
    "lib/content/launchCampaignFromContent.ts",
    "lib/content/socialPosting.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    "docs",
    "tmp",
