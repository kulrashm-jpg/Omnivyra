{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "allowJs": false
  },
  "include": [
    "next-env.d.ts",
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "lib/**/*.ts",
    "lib/**/*.tsx"
  ],
  "exclude": [
    "node_modules",
    ".next",
    "out",
    "dist",
    "build",
    "docs",
    "tmp",
    "tmp_*",
    "artifacts",
    "scripts",
    "backend/tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
