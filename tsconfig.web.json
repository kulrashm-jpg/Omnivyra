{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "noEmit": true
  },
  "include": [
    "pages/**/*.ts",
    "pages/**/*.tsx",
    "components/**/*.ts",
    "components/**/*.tsx",
    "hooks/**/*.ts",
    "hooks/**/*.tsx",
    "lib/**/*.ts",
    "types/**/*.ts"
  ],
  "exclude": [
    "pages/api/**",
    "node_modules",
    ".next",
    "out",
    "docs",
    "tmp",
    "tmp_*",
    "artifacts",
    "backend/tests",
    "**/*.test.ts",
    "**/*.spec.ts"
  ]
}
