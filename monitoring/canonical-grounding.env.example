# Canonical Grounding — operational environment variables (TEMPLATE)
# Copy the relevant lines into the Vercel (app) AND Railway (worker) environments.
# Set on BOTH surfaces to avoid app/worker skew. NEVER commit real secret values.
# Defaults shown are the code defaults; unset = default.

# ── ROLLOUT (single control point: canonicalProfileAdapter) ──────────────────
# off (default) = byte-faithful legacy | shadow = run+measure, return legacy | enforce = canonical
ROLLOUT_CANONICAL_GROUNDING_MODE=off
# Per-tenant promotion while global mode=shadow (comma-separated orgIds → enforce for them)
# ROLLOUT_CANONICAL_GROUNDING_TENANTS=

# ── KILL SWITCHES (instant OFF, no redeploy) ─────────────────────────────────
# Per-flag emergency stop → mode=off for canonical grounding only
ROLLOUT_CANONICAL_GROUNDING_KILL=0
# Global rollout kill (forces EVERY rollout flag off) — use with care
# ROLLOUT_KILL_SWITCH=

# ── CACHE (F-12, namespace omnivyra:canonical_ctx; fail-open) ────────────────
CANONICAL_CTX_TTL_SECONDS=300
# Disable ONLY the canonical context cache (grounding still assembles directly)
CACHE_KILL_OMNIVYRA_CANONICAL_CTX=0
# CACHE_KILL_ALL=  # disables ALL caches (broad; last resort)

# ── RF-2 SHADOW DIAGNOSTICS (bounded forensic buffer) ────────────────────────
CANONICAL_SHADOW_DIAG_MAX=50          # max retained overwrite diagnostics (ring)
CANONICAL_SHADOW_DIAG_WINDOW_MAX=20   # max new captures per 60s window

# ── OBSERVABILITY EXPORT (metrics endpoint is DARK until this is set) ─────────
# pages/api/observability/metrics.ts returns 404 unless this token is set.
# Provide the SAME value to the Prometheus scrape secret file. Use a strong secret.
OBSERVABILITY_EXPORT_TOKEN=__set_a_strong_random_token__

# ── EVALUATION HARNESS (NON-PRODUCTION — do NOT set in prod) ─────────────────
# RUN_LIVE_EVAL=1  EVAL_MODEL=gpt-4o-mini  EVAL_TEMPERATURE=0  EVAL_SEED=1729
